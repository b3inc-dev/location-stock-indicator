{% if product %}
  {% render 'location-stock-indicator',
    product: product,
    config: block.settings,
    root_id: block.id
  %}
{% else %}
  <p>{{ 'block.product_page_only' | t }}</p>
{% endif %}

{% schema %}
{
  "name": "t:block.name",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:settings.header_title_layout.content"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "t:settings.heading_text.label",
      "default": "t:settings.heading_text.default",
      "info": "t:settings.heading_text.info"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:settings.heading_level.label",
      "default": "h3",
      "options": [
        { "value": "h3", "label": "t:settings.heading_level.options.h3" },
        { "value": "h2", "label": "t:settings.heading_level.options.h2" }
      ],
      "info": "t:settings.heading_level.info"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:settings.heading_align.label",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:settings.heading_align.options.left" },
        { "value": "center", "label": "t:settings.heading_align.options.center" },
        { "value": "right", "label": "t:settings.heading_align.options.right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size.label",
      "min": 8,
      "max": 24,
      "step": 1,
      "default": 18
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type.label",
      "default": "list",
      "options": [
        { "value": "table", "label": "t:settings.layout_type.options.table" },
        { "value": "list", "label": "t:settings.layout_type.options.list" },
        { "value": "stacked", "label": "t:settings.layout_type.options.stacked" }
      ]
    },
    {
      "type": "select",
      "id": "location_align",
      "label": "t:settings.location_align.label",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:settings.location_align.options.left" },
        { "value": "center", "label": "t:settings.location_align.options.center" },
        { "value": "right", "label": "t:settings.location_align.options.right" }
      ]
    },
    {
      "type": "select",
      "id": "status_align",
      "label": "t:settings.status_align.label",
      "default": "right",
      "options": [
        { "value": "left", "label": "t:settings.status_align.options.left" },
        { "value": "center", "label": "t:settings.status_align.options.center" },
        { "value": "right", "label": "t:settings.status_align.options.right" }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:settings.font_size.label",
      "min": 8,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:settings.margin_bottom.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 16
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "t:settings.content_align.label",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:settings.content_align.options.left" },
        { "value": "center", "label": "t:settings.content_align.options.center" },
        { "value": "right", "label": "t:settings.content_align.options.right" }
      ]
    },
    {
      "type": "header",
      "content": "t:settings.header_legend_notice.content"
    },
    {
      "type": "select",
      "id": "legend_position",
      "label": "t:settings.legend_position.label",
      "default": "bottom_left",
      "options": [
        { "value": "top_left", "label": "t:settings.legend_position.options.top_left" },
        { "value": "top_center", "label": "t:settings.legend_position.options.top_center" },
        { "value": "top_right", "label": "t:settings.legend_position.options.top_right" },
        { "value": "bottom_left", "label": "t:settings.legend_position.options.bottom_left" },
        { "value": "bottom_center", "label": "t:settings.legend_position.options.bottom_center" },
        { "value": "bottom_right", "label": "t:settings.legend_position.options.bottom_right" }
      ]
    },
    {
      "type": "select",
      "id": "notice_position",
      "label": "t:settings.notice_position.label",
      "default": "bottom_left",
      "options": [
        { "value": "top_left", "label": "t:settings.notice_position.options.top_left" },
        { "value": "top_center", "label": "t:settings.notice_position.options.top_center" },
        { "value": "top_right", "label": "t:settings.notice_position.options.top_right" },
        { "value": "bottom_left", "label": "t:settings.notice_position.options.bottom_left" },
        { "value": "bottom_center", "label": "t:settings.notice_position.options.bottom_center" },
        { "value": "bottom_right", "label": "t:settings.notice_position.options.bottom_right" }
      ]
    },
    {
      "type": "range",
      "id": "row_padding_y",
      "label": "t:settings.row_padding_y.label",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 8,
      "info": "t:settings.row_padding_y.info"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:settings.border_style.label",
      "default": "rows",
      "options": [
        { "value": "none", "label": "t:settings.border_style.options.none" },
        { "value": "rows", "label": "t:settings.border_style.options.rows" },
        { "value": "full", "label": "t:settings.border_style.options.full" }
      ]
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color.label",
      "default": "#e3e3e3"
    },
    {
      "type": "select",
      "id": "status_color_preset",
      "label": "t:settings.status_color_preset.label",
      "default": "default",
      "options": [
        { "value": "default", "label": "t:settings.status_color_preset.options.default" },
        { "value": "muted", "label": "t:settings.status_color_preset.options.muted" },
        { "value": "mono", "label": "t:settings.status_color_preset.options.mono" }
      ]
    },
    {
      "type": "header",
      "content": "t:settings.header_region_pickup.content"
    },
    {
      "type": "paragraph",
      "content": "t:settings.region_pickup_note.content"
    },
    {
      "type": "select",
      "id": "region_style_preset",
      "label": "t:settings.region_style_preset.label",
      "default": "default",
      "options": [
        { "value": "default", "label": "t:settings.region_style_preset.options.default" },
        { "value": "subtle", "label": "t:settings.region_style_preset.options.subtle" },
        { "value": "emphasis", "label": "t:settings.region_style_preset.options.emphasis" }
      ]
    },
    {
      "type": "select",
      "id": "region_heading_align",
      "label": "t:settings.region_heading_align.label",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:settings.region_heading_align.options.left" },
        { "value": "center", "label": "t:settings.region_heading_align.options.center" },
        { "value": "right", "label": "t:settings.region_heading_align.options.right" }
      ]
    },
    {
      "type": "select",
      "id": "accordion_icon",
      "label": "t:settings.accordion_icon.label",
      "default": "chevron",
      "options": [
        { "value": "chevron", "label": "t:settings.accordion_icon.options.chevron" },
        { "value": "angle", "label": "t:settings.accordion_icon.options.angle" },
        { "value": "plus_minus", "label": "t:settings.accordion_icon.options.plus_minus" },
        { "value": "arrow", "label": "t:settings.accordion_icon.options.arrow" }
      ]
    },
    {
      "type": "select",
      "id": "order_pick_btn_style",
      "label": "t:settings.order_pick_btn_style.label",
      "default": "solid_round",
      "options": [
        { "value": "solid_square", "label": "t:settings.order_pick_btn_style.options.solid_square" },
        { "value": "solid_round", "label": "t:settings.order_pick_btn_style.options.solid_round" },
        { "value": "solid_pill", "label": "t:settings.order_pick_btn_style.options.solid_pill" },
        { "value": "outline_square", "label": "t:settings.order_pick_btn_style.options.outline_square" },
        { "value": "outline_round", "label": "t:settings.order_pick_btn_style.options.outline_round" },
        { "value": "outline_pill", "label": "t:settings.order_pick_btn_style.options.outline_pill" },
        { "value": "ghost", "label": "t:settings.order_pick_btn_style.options.ghost" }
      ]
    },
    {
      "type": "select",
      "id": "order_pick_btn_theme",
      "label": "t:settings.order_pick_btn_theme.label",
      "default": "brand",
      "options": [
        { "value": "brand", "label": "t:settings.order_pick_btn_theme.options.brand" },
        { "value": "dark", "label": "t:settings.order_pick_btn_theme.options.dark" },
        { "value": "light", "label": "t:settings.order_pick_btn_theme.options.light" }
      ]
    },
    {
      "type": "range",
      "id": "order_pick_col_width",
      "label": "t:settings.order_pick_col_width.label",
      "min": 15,
      "max": 45,
      "step": 5,
      "default": 25
    },
    {
      "type": "select",
      "id": "order_pick_btn_align",
      "label": "t:settings.order_pick_btn_align.label",
      "default": "right",
      "options": [
        { "value": "left", "label": "t:settings.order_pick_btn_align.options.left" },
        { "value": "center", "label": "t:settings.order_pick_btn_align.options.center" },
        { "value": "right", "label": "t:settings.order_pick_btn_align.options.right" }
      ]
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "t:settings.custom_css.label",
      "default": "/* custom CSS */",
      "info": "t:settings.custom_css.info"
    }
  ]
}
{% endschema %}
