{% if product %}
  {% render 'location-stock-indicator',
    product: product,
    config: block.settings,
    root_id: block.id
  %}
{% else %}
  <p>このブロックは商品ページでのみ表示されます。</p>
{% endif %}

{% schema %}
{
  "name": "Location stock indicator",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "タイトルとレイアウト"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "タイトル",
      "default": "各店舗の在庫状況",
      "info": "空欄のままにするとタイトルを表示しません。"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "タイトルの揃え",
      "default": "left",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右寄せ" }
      ]
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "タイトルの文字サイズ（px）",
      "min": 8,
      "max": 24,
      "step": 1,
      "default": 18
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "レイアウト",
      "default": "list",
      "options": [
        { "value": "table", "label": "表（テーブル）" },
        { "value": "list", "label": "リスト（1行）" },
        { "value": "stacked", "label": "2行（ロケーション名＋在庫）" }
      ]
    },
    {
      "type": "select",
      "id": "location_align",
      "label": "ロケーション名の揃え",
      "default": "left",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右寄せ" }
      ]
    },
    {
      "type": "select",
      "id": "status_align",
      "label": "在庫表示の揃え",
      "default": "right",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右寄せ" }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "本文の文字サイズ（px）",
      "min": 8,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "下マージン（px）",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 16
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "ブロック全体の配置",
      "default": "left",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央寄せ" },
        { "value": "right", "label": "右寄せ" }
      ]
    },
    {
      "type": "header",
      "content": "凡例・注意書き・行・枠線"
    },
    {
      "type": "select",
      "id": "legend_position",
      "label": "凡例の表示位置",
      "default": "bottom",
      "options": [
        { "value": "top", "label": "リストの上" },
        { "value": "bottom", "label": "リストの下" }
      ]
    },
    {
      "type": "select",
      "id": "legend_align",
      "label": "凡例の揃え",
      "default": "left",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右寄せ" }
      ]
    },
    {
      "type": "select",
      "id": "notice_position",
      "label": "注意書きの位置",
      "default": "bottom",
      "options": [
        { "value": "top", "label": "リストの上" },
        { "value": "bottom", "label": "リストの下" }
      ]
    },
    {
      "type": "select",
      "id": "notice_align",
      "label": "注意書きの揃え",
      "default": "left",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右寄せ" }
      ]
    },
    {
      "type": "range",
      "id": "row_padding_y",
      "label": "行の余白（px）",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 8,
      "info": "上下・左右の両方に適用します。"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "枠線のスタイル",
      "default": "rows",
      "options": [
        { "value": "none", "label": "枠線なし" },
        { "value": "rows", "label": "行ごとのみ" },
        { "value": "full", "label": "外枠＋行ごと" }
      ]
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "枠線の色",
      "default": "#e3e3e3"
    },
    {
      "type": "select",
      "id": "status_color_preset",
      "label": "在庫マークの色",
      "default": "default",
      "options": [
        { "value": "default", "label": "標準（緑／黄／赤）" },
        { "value": "muted", "label": "落ち着いた色" },
        { "value": "mono", "label": "モノクロ" }
      ]
    },
    {
      "type": "header",
      "content": "エリア/近隣・店舗受け取り"
    },
    {
      "type": "paragraph",
      "content": "アプリ側でエリア／近隣／店舗受け取りをONにしたときのみ反映されます。"
    },
    {
      "type": "select",
      "id": "region_style_preset",
      "label": "エリア／近隣見出しのスタイル",
      "default": "default",
      "options": [
        { "value": "default", "label": "標準" },
        { "value": "subtle", "label": "控えめ" },
        { "value": "emphasis", "label": "強調" }
      ]
    },
    {
      "type": "select",
      "id": "region_heading_align",
      "label": "見出しの配置",
      "default": "left",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右寄せ" }
      ]
    },
    {
      "type": "select",
      "id": "accordion_icon",
      "label": "折りたたみマーク",
      "default": "chevron",
      "options": [
        { "value": "chevron", "label": "三角（▼/▶）" },
        { "value": "angle", "label": "山括弧（＞/∨）" },
        { "value": "plus_minus", "label": "プラス・マイナス（+/−）" },
        { "value": "arrow", "label": "矢印（↓/→）" }
      ]
    },
    {
      "type": "select",
      "id": "order_pick_btn_style",
      "label": "受け取りボタンの形",
      "default": "solid_round",
      "options": [
        { "value": "solid_square", "label": "ソリッド×スクエア" },
        { "value": "solid_round", "label": "ソリッド×ラウンド" },
        { "value": "solid_pill", "label": "ソリッド×ピル" },
        { "value": "outline_square", "label": "アウトライン×スクエア" },
        { "value": "outline_round", "label": "アウトライン×ラウンド" },
        { "value": "outline_pill", "label": "アウトライン×ピル" },
        { "value": "ghost", "label": "ゴースト" }
      ]
    },
    {
      "type": "select",
      "id": "order_pick_btn_theme",
      "label": "受け取りボタンの色",
      "default": "brand",
      "options": [
        { "value": "brand", "label": "ブランド（濃い青）" },
        { "value": "dark", "label": "ダーク" },
        { "value": "light", "label": "ライト" }
      ]
    },
    {
      "type": "range",
      "id": "order_pick_col_width",
      "label": "ボタン列の幅（テーブル時・%）",
      "min": 15,
      "max": 45,
      "step": 5,
      "default": 25
    },
    {
      "type": "select",
      "id": "order_pick_btn_align",
      "label": "ボタンの左右位置",
      "default": "right",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右寄せ" }
      ]
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "追加CSS",
      "default": "/* custom CSS */",
      "info": "ルートは #lsi-（block ID） をセレクタに使えます。"
    }
  ]
}
{% endschema %}
