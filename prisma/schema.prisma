// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
//
// Production (Render public + Ciara): set DATABASE_URL to a persistent Postgres URL
// (Render Postgres Internal Database URL). Ephemeral SQLite on the web service disk
// is wiped on every deploy and causes missing_admin_client after redeploy.
// Local: postgresql://USER:PASSWORD@localhost:5432/location_stock?schema=public
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Pro の 1 ロケーション $2 の従量を App Events API で報告した記録（公開用だけ）。
/// 1 店・1 請求期間（Shopify の currentPeriodEnd）に 1 行。status: disabled / sending / sent / failed / over_limit
model AppUsageReport {
  id             String    @id @default(cuid())
  shop           String
  periodEnd      String
  plan           String
  eventHandle    String
  locationsCount Int
  units          Int
  idempotencyKey String    @unique
  status         String
  httpStatus     Int?
  lastError      String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, periodEnd])
  @@index([status])
}
