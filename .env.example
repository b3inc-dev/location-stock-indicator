# Copy to .env for local development. Do not commit real secrets.
# Prisma Session storage (required). Use PostgreSQL — SQLite is not supported after the postgres migration.
# Example local: Docker `postgres:16` on 5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/location_stock?schema=public"

# Shopify (from `shopify app env show` for the active toml)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=
# SHOPIFY_APP_URL=
